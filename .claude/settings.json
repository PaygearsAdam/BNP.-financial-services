{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(npm test *)",
      "Bash(npm run *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
